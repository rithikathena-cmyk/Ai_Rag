# Copy these keys into Streamlit Community Cloud's app settings -> Secrets
# (paste as TOML, not this filename). For local testing only, you can instead
# copy this file to frontend/.streamlit/secrets.toml (gitignored) and run
# `streamlit run` from frontend/app/.
#
# Streamlit exposes every key below both as st.secrets[...] and as a regular
# OS environment variable, so frontend/app/api_client.py's
# os.environ.get("BACKEND_URL") picks this up with no code changes.

BACKEND_URL = "https://<your-cloudflare-tunnel-domain>"

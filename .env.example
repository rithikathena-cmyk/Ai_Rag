# Native (non-Docker) run only — docker-compose.yml overrides this to the
# `qdrant` service name for its own backend container regardless of what's
# set here. Leave QDRANT_URL blank for this local/Docker mode.
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
# Qdrant Cloud mode — set this (a full https:// URL from your cluster's
# dashboard) plus QDRANT_API_KEY to use a managed cluster instead of
# QDRANT_HOST/QDRANT_PORT above. See docs/DEPLOYMENT_FREE_MANAGED.md.
QDRANT_URL=
QDRANT_API_KEY=
BACKEND_HOST=
BACKEND_PORT=8000
FRONTEND_PORT=
BACKEND_URL=
ENVIRONMENT=
POSTGRES_HOST=
POSTGRES_PORT=
# Host-side port docker-compose.yml publishes its Postgres container on.
# Change this (not POSTGRES_PORT above) if 5432 is already taken by a native
# Postgres install — see docs/DEPLOYMENT_FREE_TUNNEL.md.
POSTGRES_HOST_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Set to "require" for managed Postgres (Supabase, etc.) — leave blank for
# local/Docker Postgres, which has no SSL configured. See
# docs/DEPLOYMENT_FREE_MANAGED.md.
POSTGRES_SSLMODE=
MAX_UPLOAD_SIZE_MB=
ANTHROPIC_API_KEY=

# Comma-separated. Include the Streamlit Community Cloud app URL once
# deployed, e.g. http://localhost:8501,https://your-app.streamlit.app
CORS_ALLOWED_ORIGINS=http://localhost:8501

# Optional — only read if backend/config/guardrails.yaml's
# llm_advanced_check.enabled is set to true (off by default). Get a free-tier
# key at https://aistudio.google.com/apikey — see docs/GUARDRAILS_ARCHITECTURE.md §10.
GEMINI_API_KEY=

JWT_SECRET_KEY=
# Only used when GUARDRAIL_PII_MODE=hash — set a long random value in
# production (dev-safe insecure default otherwise). See
# docs/GUARDRAILS_ARCHITECTURE.md §11.
GUARDRAIL_PII_HASH_SALT=

# Seeds one admin account on startup (idempotent, no-op once it exists).
# Leave both blank to skip — see db/postgres.py::_bootstrap_admin_user.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
